generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 选题
model Topic {
  id           Int       @id @default(autoincrement())
  title        String
  hook         String    @default("") // 开头钩子
  category     String    @default("故事") // 故事 | 方法 | 工具
  status       String    @default("待写") // 待写 | 已写稿 | 已发布 | 已废弃
  linkedCardId Int? // 关联概念卡
  audience     String    @default("") // 定位：核心人群
  demand       String    @default("") // 定位：需求问题
  painPoint    String    @default("") // 定位：痛点
  solution     String    @default("") // 定位：解决方案
  createdAt    DateTime  @default(now())
  contents     Content[]
}

// 文案（与选题一对一）
model Content {
  id           Int       @id @default(autoincrement())
  topicId      Int       @unique
  body         String    @default("")
  wordCount    Int       @default(0)
  durationEst  Int       @default(0) // 预估口播时长（秒）
  status       String    @default("写稿中") // 写稿中 | 已定稿 | 已发布
  plannedDate  DateTime? // 计划发布日
  publishedDate DateTime? // 实际发布日
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  metrics      Metric[]
}

// 作品数据（一条文案 × 一个平台 × 一个日期 = 一条记录）
model Metric {
  id            Int      @id @default(autoincrement())
  contentId     Int
  platform      String // 抖音 | 小红书
  date          DateTime
  views         Int      @default(0)
  completion3s  Float? // 3秒完播率 %
  completionFull Float? // 总完播率 %
  likes         Int      @default(0)
  comments      Int      @default(0)
  saves         Int      @default(0)
  shares        Int      @default(0)
  newFans       Int      @default(0)
  iterationNote String   @default("") // 迭代日志：这条为什么好/差
  createdAt     DateTime @default(now())
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

// 键值配置（自定义禁词等）
model Setting {
  key   String @id
  value String // JSON 字符串
}

// 资源库：书籍 / 视频 / 课程 / 文章 / 播客 等导入的一切
model Source {
  id          Int      @id @default(autoincrement())
  type        String   @default("书籍") // 书籍 | 视频 | 课程 | 文章 | 播客 | 其他
  title       String
  author      String   @default("")
  url         String   @default("")
  description String   @default("")
  status      String   @default("待处理") // 待处理 | 进行中 | 已完成
  tags        String   @default("") // 逗号分隔
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 概念卡
model Card {
  id           Int      @id @default(autoincrement())
  title        String
  oneLiner     String   @default("") // 一句话版本
  source       String   @default("") // 来源（书名/课程/视频名）
  keyPoints    String   @default("") // 核心要点，一行一条
  myExperience String   @default("") // 我的真实经历
  scriptDraft  String   @default("") // 口播话术草稿
  status       String   @default("待补经历") // 待补经历 | 可写稿 | 已发布
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 课程笔记（课程 → 集数 两级归档）
model Note {
  id        Int      @id @default(autoincrement())
  course    String
  episode   String   @default("")
  content   String   @default("") // markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 案例库（情绪数据库）
model Case {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  trigger       String   @default("") // 触发事件
  emotionType   String   @default("其他") // 焦虑 | 愤怒 | 悲伤 | 恐惧 | 羞愧 | 内疚 | 无力 | 喜悦 | 平静 | 其他
  bodySignal    String   @default("") // 身体信号
  action        String   @default("") // 当时行动
  result        String   @default("") // 结果
  usableAsTopic Boolean  @default(false) // 可用作选题
  createdAt     DateTime @default(now())
}

// 金句库
model Quote {
  id        Int      @id @default(autoincrement())
  text      String
  source    String   @default("") // 出处
  createdAt DateTime @default(now())
}
